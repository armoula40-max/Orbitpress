+/* ------------------------------------------------------------------ */
+/* جلسات وتشخيص — دوال صافية تُختبر في CI بدون متصفح                     */
+/* ------------------------------------------------------------------ */
+
+const SESSION_COOKIE_NAMES = {
+  facebook: cookies => cookies.has('c_user') && cookies.has('xs'),
+  pinterest: cookies => cookies.has('_pinterest_sess') || cookies.has('pinterest_sess')
+};
+
+/** هل تحتوي قائمة الـ cookies على جلسة دخول كاملة للمنصة؟ */
+export function hasSessionCookies(platform, cookies = []) {
+  const names = new Set((Array.isArray(cookies) ? cookies : []).filter(cookie => cookie && typeof cookie.name === 'string').map(cookie => cookie.name));
+  const rule = SESSION_COOKIE_NAMES[platform];
+  return rule ? rule(names) : false;
+}
+
+/**
+ * يحوّل الـ cookies القادمة من تطبيق OrbitPress ({name, value}) إلى صيغة Playwright.
+ * بدون `expires` يعتبرها Chromium session cookies ولا يحفظها في ملف الجلسة، لذلك نمنحها مدة صلاحية.
+ */
+export function sanitizeForwardedCookies(platform, cookies = [], { nowSeconds = Math.floor(Date.now() / 1000), ttlSeconds = 30 * 24 * 3600, max = 150 } = {}) {
+  const domain = platform === 'facebook' ? '.facebook.com' : '.pinterest.com';
+  const domainMatch = platform === 'facebook' ? /(^|\.)facebook\.com$/i : /(^|\.)pinterest\.com$/i;
+  return (Array.isArray(cookies) ? cookies : [])
+    .filter(cookie => cookie && typeof cookie.name === 'string' && typeof cookie.value === 'string' && cookie.name.length > 0 && cookie.name.length <= 160 && cookie.value.length <= 10000)
+    .filter(cookie => !cookie.domain || domainMatch.test(String(cookie.domain).replace(/^\./, '')))
+    .slice(0, max)
+    .map(cookie => {
+      const requested = Number(cookie.expires);
+      const expires = Number.isFinite(requested) && requested > nowSeconds ? Math.floor(requested) : nowSeconds + ttlSeconds;
+      return {
+        name: cookie.name,
+        value: cookie.value,
+        domain,
+        path: typeof cookie.path === 'string' && cookie.path.startsWith('/') ? cookie.path : '/',
+        expires,
+        httpOnly: Boolean(cookie.httpOnly),
+        secure: true,
+        sameSite: ['Strict', 'Lax', 'None'].includes(cookie.sameSite) ? cookie.sameSite : 'Lax'
+      };
+    });
+}
+
+/** مهلة المهمة: يحترم `timeoutSeconds` الذي يرسله التطبيق ضمن حدّ أقصى يحدده الخادم. */
+export function resolveJobTimeout({ requestedSeconds, defaultMs = 180000, maxMs = 600000, minMs = 15000 } = {}) {
+  const requested = Number(requestedSeconds);
+  if (!Number.isFinite(requested) || requested <= 0) return Math.min(defaultMs, maxMs);
+  return Math.max(minMs, Math.min(Math.round(requested * 1000), maxMs));
+}
+
+const UNAVAILABLE_PATTERNS = /(content isn't available|page isn't available|content not found|page not found|isn't available right now|no longer available|may have been removed|هذا المحتوى غير متاح)/i;
+const UNSUPPORTED_PATTERNS = /(unsupported browser|update your browser|browser is no longer supported|browser isn't supported)/i;
+
+/**
+ * يصف نتيجة سحب Facebook فارغة بحالة واحدة واضحة بدلاً من التحذير العام.
+ * state ∈ ok | checkpoint | login_wall | session_rejected | unavailable | unsupported_browser | no_posts
+ */
+export function describeFacebookOutcome({
+  postCount = 0, loginFormCount = 0, finalUrl = '', title = '', bodyPreview = '', articleCount = 0, postLinkCount = 0,
+  cookiesSent = 0, sessionForwarded = false, sessionAccepted = false
+} = {}) {
+  if (postCount > 0) return { state: 'ok', loginRequired: false, warning: undefined };
+  const url = String(finalUrl || '').toLowerCase();
+  const pageTitle = String(title || '').toLowerCase();
+  const body = String(bodyPreview || '');
+  const checkpoint = /checkpoint/.test(url) || /checkpoint/.test(pageTitle);
+  const redirectedToLogin = /\/login|login\.php|\/recover/.test(url);
+  const loginWall = checkpoint || redirectedToLogin || Number(loginFormCount) > 0 || /^log ?in(to)? facebook/.test(pageTitle);
+  if (checkpoint) {
+    return { state: 'checkpoint', loginRequired: true, warning: 'Facebook put the VPS browser session into a security checkpoint. Open Facebook once in the OrbitPress Visible scan (or the VPS visual browser), confirm your identity, then retry.' };
+  }
+  if (loginWall && !sessionForwarded && !sessionAccepted) {
+    return { state: 'login_wall', loginRequired: true, warning: `Facebook showed a login wall and the VPS browser had no login session (${Number(cookiesSent) || 0} cookie(s) received, none of them c_user+xs). Log in once through the OrbitPress Visible scan so the session is forwarded, or import a session on the VPS.` };
+  }
+  if (loginWall && !sessionAccepted) {
+    return { state: 'session_rejected', loginRequired: true, warning: 'Facebook rejected the forwarded login session: the login form is still shown and the c_user/xs cookies were dropped. Log out and back in through the Visible scan, then retry.' };
+  }
+  if (loginWall) {
+    return { state: 'login_wall', loginRequired: true, warning: 'Facebook still shows a login form to the VPS browser although session cookies are present. Retry once; if it persists, refresh the login through the Visible scan.' };
+  }
+  if (UNAVAILABLE_PATTERNS.test(body) || UNAVAILABLE_PATTERNS.test(pageTitle)) {
+    return { state: 'unavailable', loginRequired: false, warning: 'Facebook says this content is not available to the VPS browser (private, region/age restricted or removed). Check the URL in a normal browser while logged in.' };
+  }
+  if (UNSUPPORTED_PATTERNS.test(body) || UNSUPPORTED_PATTERNS.test(pageTitle)) {
+    return { state: 'unsupported_browser', loginRequired: false, warning: 'Facebook flagged the VPS browser as unsupported. Keep BROWSER_CHANNEL=chromium (new headless mode) or set a realistic BROWSER_USER_AGENT in .env.' };
+  }
+  return {
+    state: 'no_posts',
+    loginRequired: false,
+    warning: `Facebook rendered ${Number(articleCount) || 0} article element(s) and ${Number(postLinkCount) || 0} post link(s) for the VPS browser (${sessionAccepted ? 'logged in' : 'logged out'}), but none matched a public post. Use the Page's main URL (https://www.facebook.com/<page>/); if it is correct, the Playwright selectors in src/server.js need an update.`
+  };
+}

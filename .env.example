# OrbitPress build-time defaults (copy to `.env` at the repository root; `.env` is git-ignored).
# Read by app/build.gradle.kts and baked into BuildConfig.
# The app uses these ONLY when the "VPS Scraper API" fields in Settings are left blank;
# anything typed in Settings always wins and is stored encrypted per site.

# HTTPS only. Trailing slash is optional.
ORBITPRESS_SCRAPER_URL=https://23.95.186.208.sslip.io

# Optional. Leaving it empty keeps the key OUT of the APK (recommended for public repos):
# users then paste the key from the VPS `.env` into Settings once.
# If you set it here (or via the ORBITPRESS_SCRAPER_KEY GitHub secret) the APK ships with a default key.
ORBITPRESS_SCRAPER_KEY=

# ---- Optional release signing (leave empty to produce an unsigned release APK) ----
# Path to a JKS/PKCS12 keystore relative to the repository root (never commit the keystore itself).
# Create one with:  keytool -genkeypair -v -keystore orbitpress-release.jks -alias orbitpress -keyalg RSA -keysize 2048 -validity 10000
ORBITPRESS_KEYSTORE_FILE=
ORBITPRESS_KEYSTORE_PASSWORD=
ORBITPRESS_KEY_ALIAS=
# Defaults to ORBITPRESS_KEYSTORE_PASSWORD when empty.
ORBITPRESS_KEY_PASSWORD=

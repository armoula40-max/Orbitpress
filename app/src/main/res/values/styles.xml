<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- OrbitPress 4.1 Modern Theme - Vibrant rose + engagement blue -->
  <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
    <item name="colorPrimary">#E11D48</item>
    <item name="colorOnPrimary">#FFFFFF</item>
    <item name="colorPrimaryContainer">#FFDAD6</item>
    <item name="colorSecondary">#FB7185</item>
    <item name="colorOnSecondary">#0F172A</item>
    <item name="colorTertiary">#2563EB</item>
    <item name="colorOnTertiary">#FFFFFF</item>
    <item name="android:colorBackground">#FFF1F2</item>
    <item name="colorSurface">#FFFFFF</item>
    <item name="colorOnSurface">#881337</item>
    <item name="colorSurfaceVariant">#F0ECF2</item>
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@android:color/transparent</item>
    <item name="android:windowLightStatusBar">true</item>
    <item name="android:windowLightNavigationBar">true</item>
    <item name="android:windowTranslucentStatus">false</item>
    <item name="android:windowTranslucentNavigation">false</item>
    <item name="android:windowBackground">#FFF1F2</item>
  </style>

  <style name="AppTheme.Splash">
    <item name="android:windowBackground">@drawable/ic_orbitpress</item>
    <item name="android:statusBarColor">#E11D48</item>
  </style>
</resources>
